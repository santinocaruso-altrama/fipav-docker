# Variabili del compose. Copia in .env e adatta se serve.
# Tutti i valori qui sotto sono già i default: il file serve solo a cambiarli.

# ─── Porte sull'host ─────────────────────────────────────────────
# Il gateway: se la 80 è occupata (Apache/nginx locale, Docker Desktop),
# metti ad esempio 8000. Ricordati che cambiandola cambiano anche gli URL
# di BACKOFFICE_API_BASE_URL e COMTER_ROOT_DOMAIN.
GATEWAY_PORT=80

# Porta HTTPS del gateway. Pubblicata anche in locale, dove resta inutilizzata:
# con GATEWAY_SITES=http:// Caddy non ascolta in TLS. Cambiala se la 443 e' gia'
# occupata sulla tua macchina.
HTTPS_PORT=443

# Accesso legacy a fipav-core con l'API su root.
CORE_LEGACY_PORT=8080

MARIADB_PORT=3307
REDIS_PORT=6379
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
MEILI_PORT=7700

# ─── fipav-core ──────────────────────────────────────────────────
# Conta solo per gli URL generati da CLI (queue, mail, comandi artisan):
# nelle richieste HTTP Laravel deduce il base URL dalla request.
CORE_APP_URL=http://localhost/core

# Prefisso delle immagini emesse da asset() (es. /images/discipline/*.jpg).
#
# Un percorso, non un URL: le immagini escono come /core/images/... senza
# hostname, quindi il browser le risolve sull'origine della pagina e il valore
# resta identico in locale, staging e produzione.
#
# Senza questa variabile Laravel costruirebbe l'URL sul root della request, che
# per le chiamate server-side di comter e' http://fipav-nginx: hostname della
# rete Docker, che il browser non risolve.
CORE_ASSET_URL=/core

# `debug` abilita Xdebug su ogni richiesta. Mettilo a `off` per recuperare
# parecchie decine di ms per richiesta quando non stai debuggando.
XDEBUG_MODE=debug

# ─── fipav-backoffice ────────────────────────────────────────────
# Letto dal browser, quindi deve essere l'URL pubblico. Same-origin rispetto
# al gateway: nessun CORS da configurare.
BACKOFFICE_API_BASE_URL=http://localhost/core

# ─── fipav-comter-frontend ───────────────────────────────────────
# Chiamate server-side: restano nella rete Docker e non attraversano il gateway.
COMTER_API_BASE_URL=http://fipav-nginx/api/v1/public/cms

# Root domain da cui src/proxy.ts ricava il tenant dal sottodominio.
# In locale: localhost      -> calabria.localhost
# In staging: fipav.altrama.it -> calabria.fipav.altrama.it
COMTER_ROOT_DOMAIN=localhost

COMTER_IMAGE_ALLOWED_DOMAINS=http://localhost

# ─── Gateway: hostname e HTTPS ───────────────────────────────────
# Vedi docs/superpowers/specs/2026-07-29-https-letsencrypt-design.md

# Indirizzi serviti dal gateway Caddy. E' l'unica variabile che distingue il
# locale dallo staging.
#
#   http://     -> qualunque Host sulla porta 80, in chiaro, nessun
#                  certificato. E' l'equivalente del `server_name _` di nginx
#                  e il comportamento di sviluppo di sempre.
#
#   un elenco di hostname separati da spazio -> Caddy attiva l'HTTPS
#                  automatico: ottiene i certificati da Let's Encrypt al primo
#                  avvio, li rinnova da se' e reindirizza http a https. Non
#                  serve nessun altro comando, ne' ora ne' fra 60 giorni.
#
# Per aggiungere un comitato: aggiungi il suo hostname qui e riavvia il
# gateway. Il DNS non si tocca, il record A wildcard *.fipav.altrama.it lo
# copre gia'.
GATEWAY_SITES=http://
# Staging:
# GATEWAY_SITES=calabria.fipav.altrama.it cosenza.fipav.altrama.it lazio.fipav.altrama.it roma.fipav.altrama.it

# Nessuna variabile per l'indirizzo dell'account ACME: la direttiva `email` di
# Caddy non ammette un valore vuoto, quindi renderla configurabile romperebbe il
# gateway in locale. Se vuoi gli avvisi di scadenza (non necessari, il rinnovo e'
# automatico) aggiungi `email indirizzo@dominio` nel blocco globale del
# docker/gateway/Caddyfile.

# Directory ACME. Il default e' la produzione. Per fare prove con hostname veri
# senza consumare i rate limit (5 certificati a settimana per set di nomi) metti
# la directory di staging: i certificati emessi non sono validi per i browser.
#
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# ─── Credenziali ─────────────────────────────────────────────────
# In locale il default `root` va bene. Su una macchina pubblica va cambiata:
# l'overlay docker-compose.staging.yml chiude le porte dei servizi, ma la
# password resta l'ultima difesa se qualcuno arriva sulla rete Docker.
MARIADB_ROOT_PASSWORD=root
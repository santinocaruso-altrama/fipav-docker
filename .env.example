# ─── Porte sull'host ─────────────────────────────────────────────
GATEWAY_PORT=80
HTTPS_PORT=443
MARIADB_PORT=3307
REDIS_PORT=6379
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
MEILI_PORT=7700

# ─── fipav-core ──────────────────────────────────────────────────
# Conta solo per gli URL generati da CLI (queue, mail, comandi artisan):
CORE_APP_URL=http://localhost/core
CORE_ASSET_URL=/core
XDEBUG_MODE=debug

# ─── fipav-backoffice ────────────────────────────────────────────
BACKOFFICE_API_BASE_URL=http://localhost/core

# Sentry (error tracking). Va impostato solo in .env.stage: l'SDK si
# inizializza solo nella build di produzione (vedi src/lib/sentry.ts),
# quindi in dev resta inerte anche se vuoto.
BACKOFFICE_SENTRY_DSN=

# ─── fipav-comter-frontend ───────────────────────────────────────
# Root domain da cui src/proxy.ts ricava il tenant dal sottodominio.
#
# In locale: localhost          -> calabria.localhost
# In staging: fipav.altrama.it  -> calabria.fipav.altrama.it
COMTER_ROOT_DOMAIN=localhost

# Sentry (error tracking). Il DSN non e' un segreto (e' pensato per essere
# pubblico), ma va comunque impostato solo in .env.stage: l'SDK si
# inizializza solo con NODE_ENV=production (build di stage, vedi
# docker/comter/stage/Dockerfile), quindi in dev resta inerte anche se vuoto.
COMTER_SENTRY_DSN=

# ─── Gateway: hostname e HTTPS ───────────────────────────────────
# docker run --rm caddy:alpine caddy hash-password --plaintext 'la-password'
#
# HORIZON_BASIC_AUTH_USER=fipav
# HORIZON_BASIC_AUTH_HASH=******

# ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# ─── Credenziali ─────────────────────────────────────────────────
MARIADB_ROOT_PASSWORD=root
MARIADB_USER=fipav
MARIADB_PASSWORD=fipav

# Genera una chiave con: $ openssl rand -base64 24
# MEILI_MASTER_KEY=
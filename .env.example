# Variabili del compose. Copia in .env e adatta se serve.
# Tutti i valori qui sotto sono già i default: il file serve solo a cambiarli.

# ─── Porte sull'host ─────────────────────────────────────────────
# Il gateway: se la 80 è occupata (Apache/nginx locale, Docker Desktop),
# metti ad esempio 8000. Ricordati che cambiandola cambiano anche gli URL
# di BACKOFFICE_API_BASE_URL e COMTER_ROOT_DOMAIN.
GATEWAY_PORT=80

# Accesso legacy a fipav-core con l'API su root.
CORE_LEGACY_PORT=8080

MARIADB_PORT=3307
REDIS_PORT=6379
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
MEILI_PORT=7700

# ─── fipav-core ──────────────────────────────────────────────────
# Conta solo per gli URL generati da CLI (queue, mail, comandi artisan):
# nelle richieste HTTP Laravel deduce il base URL dalla request.
CORE_APP_URL=http://localhost/core

# Prefisso delle immagini emesse da asset() (es. /images/discipline/*.jpg).
#
# Un percorso, non un URL: le immagini escono come /core/images/... senza
# hostname, quindi il browser le risolve sull'origine della pagina e il valore
# resta identico in locale, staging e produzione.
#
# Senza questa variabile Laravel costruirebbe l'URL sul root della request, che
# per le chiamate server-side di comter e' http://fipav-nginx: hostname della
# rete Docker, che il browser non risolve.
CORE_ASSET_URL=/core

# `debug` abilita Xdebug su ogni richiesta. Mettilo a `off` per recuperare
# parecchie decine di ms per richiesta quando non stai debuggando.
XDEBUG_MODE=debug

# ─── fipav-backoffice ────────────────────────────────────────────
# Letto dal browser, quindi deve essere l'URL pubblico. Same-origin rispetto
# al gateway: nessun CORS da configurare.
BACKOFFICE_API_BASE_URL=http://localhost/core

# ─── fipav-comter-frontend ───────────────────────────────────────
# Chiamate server-side: restano nella rete Docker e non attraversano il gateway.
COMTER_API_BASE_URL=http://fipav-nginx/api/v1/public/cms

# Root domain da cui src/proxy.ts ricava il tenant dal sottodominio.
# In locale: localhost      -> calabria.localhost
# In staging: fipav.altrama.it -> calabria.fipav.altrama.it
COMTER_ROOT_DOMAIN=localhost

COMTER_IMAGE_ALLOWED_DOMAINS=http://localhost